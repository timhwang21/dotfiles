{
  "permissions": {
    "allow": [
      "Bash(cat:*)",
      "Bash(chmod:*)",
      "Bash(cp:*)",
      "Bash(echo:*)",
      "Bash(jq:*)",
      "Bash(mv:*)",
      "Bash(touch:*)",
      "Bash(true)",
      "Bash(find:*)",
      "Bash(sed:*)",
      "Bash(awk:*)",
      "Bash(docker compose:*)",
      "Bash(docker run:*)",
      "Bash(git add:*)",
      "Bash(git branch:*)",
      "Bash(git checkout:*)",
      "Bash(git fetch:*)",
      "Bash(git log:*)",
      "Bash(git rebase:*)",
      "Bash(git stash:*)",
      "Bash(grep:*)",
      "Bash(ls:*)",
      "Bash(mkdir:*)",
      "Bash(rg:*)",
      "Bash(yarn:*)",
      "WebFetch(domain:github.com)",
      "WebFetch(domain:learn.microsoft.com)",
      "mcp__buildkite__get_build",
      "mcp__buildkite__get_job_logs",
      "mcp__buildkite__get_jobs",
      "mcp__context7__get-library-docs",
      "mcp__context7__resolve-library-id",
      "mcp__datadog__get_events",
      "mcp__datadog__get_logs",
      "mcp__datadog__get_metrics",
      "mcp__puppeteer__puppeteer_evaluate",
      "mcp__puppeteer__puppeteer_navigate",
      "mcp__puppeteer__puppeteer_screenshot"
    ],
    "deny": []
  },
  "model": "opus[1m]",
  "statusLine": {
    "type": "command",
    "command": "bash ~/.claude/statusline-command.sh"
  },
  "enabledPlugins": {
    "playground@claude-plugins-official": true,
    "plugin-dev@claude-plugins-official": true,
    "persona-context-mode@persona-claude-marketplace": true,
    "persona-web-help@persona-claude-marketplace": true
  }
}
